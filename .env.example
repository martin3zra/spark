APP_NAME=Spark
APP_ENV=local
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}
# 64 random bytes, base64-encoded. Generate: ./cli generate:key
APP_KEY=

# postgres, mysql, or sqlite
DB_DRIVER=postgres
# Ready-made DSN — set this and skip the fields below. Examples:
#   postgres: postgres://user:pass@localhost:5432/spark?sslmode=disable
#   mysql:    user:pass@tcp(localhost:3306)/spark?parseTime=true
#   sqlite:   spark.sqlite (or :memory:)
DB_SOURCE=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spark
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

SESSION_LIFETIME=120

# Everything logged via the standard `log` package (server lifecycle,
# mailer.Log's dumped emails, CLI command output, ...) is written here in
# addition to stderr. `spark new` sets this to <project>.log for you.
LOG_FILE=spark.log

# App shell: "sidebar" (default) or "topnav". Read at build time by Vite —
# changing it requires a rebuild (npm run build, or restart `npm run dev`).
VITE_APP_LAYOUT=sidebar
